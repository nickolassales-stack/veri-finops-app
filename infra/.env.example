# =============================================================================
# Portal FinOps VERI -- modelo de variaveis de ambiente
# -----------------------------------------------------------------------------
# Copie este arquivo para `.env` NO MESMO DIRETORIO do docker-compose.yml usado
# no deploy (ex.: /opt/finops/.env) e preencha os valores reais.
#
#   cp infra/.env.example /opt/finops/.env && chmod 600 /opt/finops/.env
#
# O `.env` NUNCA deve ser versionado (ja bloqueado no .gitignore). Este modelo
# nao contem nenhum segredo real -- todo valor sensivel esta como marcador.
#
# COMO LER O "(!)": as variaveis marcadas assim NAO tem padrao. O compose se
# recusa a subir sem elas, de proposito -- e melhor falhar na hora do que subir
# com uma senha vazia e descobrir depois.
# =============================================================================

# =============================================================================
# Build e imagem
# =============================================================================

# (!) Caminho ABSOLUTO do diretorio web/ do repositorio clonado na EC2.
#     E o contexto de build da imagem.
APP_BUILD_CONTEXT=/opt/veri-finops/web

# Tag da imagem construida. O script de operacao usa a tag `anterior` para
# rollback: nao a reutilize aqui.
APP_IMAGE_TAG=local

# =============================================================================
# Banco de dados -- o MESMO do ETL/Metabase, em leitura + governanca
# =============================================================================

# Nome do banco. O portal nao cria nem migra nada nas tabelas de custo.
PG_DB=finops

# Host do Postgres do ponto de vista do CONTAINER. `postgres` e o nome do
# servico no compose de producao, resolvido pela rede interna do Docker -- sem
# passar por nenhuma porta publicada.
APP_PG_HOST=postgres

# (!) Usuario dedicado da aplicacao. NAO reutilize finops_user (dono do schema):
#     o portal deve ter permissao minima -- SELECT nas tabelas do ETL e escrita
#     apenas nas de governanca. Ver scripts/create-app-role.sql e
#     docs/RUNBOOK-app.md secao 5.
APP_PG_USER=finops_app

# (!) Gere uma senha forte e unica. Nao reaproveite a do finops_user.
APP_PG_PASSWORD=troque-por-uma-senha-forte-e-unica

# Pool pequeno: o PostgreSQL e compartilhado com o Metabase, que abre varias
# conexoes. Subir isto sem olhar o `max_connections` do banco tira conexao do
# Metabase.
APP_PG_POOL_MAX=5

# Corta consulta travada antes que ela prejudique o banco de producao.
APP_PG_STATEMENT_TIMEOUT_MS=15000

# =============================================================================
# Publicacao da porta
# =============================================================================

# 3001 no host porque 3000 e do METABASE. Nao troque para 3000: o portal
# tomaria a porta e o Metabase deixaria de subir no proximo restart.
APP_PORT=3001

# Padrao seguro: somente loopback da EC2. Acesse por tunel SSH:
#   ssh -i chave.pem -N -L 3001:localhost:3001 ec2-user@HOST
#
# So troque para 0.0.0.0 DEPOIS de colocar Nginx + HTTPS na frente e restringir
# o Security Group. Sem isso, login e dado financeiro trafegam em claro.
APP_BIND=127.0.0.1

# Limite de memoria do container. A EC2 tem ~4 GiB e o Metabase (JVM) ja sofreu
# OOM nesta instancia; o teto existe para o portal nao causar regressao nele.
APP_MEM_LIMIT=512m

# Fuso usado para formatar datas na interface e resolver "hoje".
APP_TZ=America/Sao_Paulo

# =============================================================================
# Autenticacao
# =============================================================================

# Validade da sessao em horas. Nao ha renovacao deslizante: expira em tempo fixo.
AUTH_SESSION_TTL_HOURS=12

# Atributo `Secure` do cookie de sessao. MANTENHA `true`.
# Funciona no fluxo atual porque o acesso e por tunel SSH para 127.0.0.1, e
# navegadores tratam http://localhost como contexto seguro.
# So mude para `false` se precisar acessar por HTTP em host que NAO seja
# localhost -- e nesse caso a sessao trafega em claro. O certo e Nginx + HTTPS.
AUTH_COOKIE_SECURE=true

# =============================================================================
# Cotacao USD/BRL (estimativa visual)
# =============================================================================
#
# A conversao para BRL e APENAS INDICATIVA. O valor oficial da AWS e em USD e e
# assim que ele e armazenado e exibido -- nada em BRL e gravado no banco.
#
# Exige saida HTTPS do container para o Banco Central. Verificado na EC2 FinOps
# em 06/08/2026: host e container alcancam olinda.bcb.gov.br e api.bcb.gov.br.
# Se a saida for bloqueada, use `nenhum` e o portal segue normal, so em USD.

# ptax    -> PTAX do Banco Central via Olinda (traz a hora do boletim). Padrao.
# sgs     -> serie 1 do SGS do Banco Central (mesmo valor, so a data).
# nenhum  -> desliga a estimativa. Nenhuma chamada externa e feita.
EXCHANGE_RATE_PROVIDER=ptax

# Validade do cache em memoria. O PTAX publica um boletim de fechamento por dia
# util (~13h), entao 1 hora pega o valor novo logo depois sem martelar o BCB.
EXCHANGE_RATE_CACHE_TTL_SECONDS=3600

# Teto de espera pela API externa. Curto de proposito: a cotacao nao pode
# segurar a resposta do custo em USD.
EXCHANGE_RATE_TIMEOUT_MS=4000

# =============================================================================
# Exportacao (CSV / XLSX)
# =============================================================================
#
# Teto de linhas por arquivo exportado. E a unica operacao do portal cujo custo
# cresce com o tamanho da BASE, e nao com o tamanho da tela -- e o container roda
# com APP_MEM_LIMIT ao lado de um Metabase que ja sofreu OOM nesta EC2.
#
# Acima do teto a exportacao e RECUSADA (HTTP 413) com mensagem pedindo para
# estreitar o filtro. Nunca truncada: arquivo cortado com cara de completo e o
# pior desfecho possivel para um relatorio financeiro.
#
# O CSV e transmitido em streaming e o banco e lido em lotes, entao o consumo de
# memoria do CSV independe do teto. O XLSX precisa montar a planilha inteira
# antes de compactar -- e ele que o teto realmente protege. Se subir muito este
# valor, suba APP_MEM_LIMIT junto.
EXPORT_MAX_ROWS=50000

# =============================================================================
# Monitoramento do ETL (tela /dashboard/diagnostico)
# -----------------------------------------------------------------------------
# ATENCAO AO FUSO. O cron da EC2 e `0 8 * * *` e o servidor esta em Etc/UTC:
# isso dispara as 08:00 UTC, que sao 05:00 em Sao Paulo -- NAO as 8h da manha do
# horario de Brasilia. Os padroes abaixo descrevem o cron REAL de hoje.
#
# O portal nao le o crontab (roda em container, sem acesso ao host): ele apenas
# ACREDITA no que estas variaveis dizem. Mudar aqui nao muda o agendamento;
# mudar o cron sem mudar aqui faz a tela cobrar a carga na hora errada. Os dois
# passos andam juntos -- ver README, "Como ajustar o cron".
ETL_HORARIO_ESPERADO=08:00
ETL_FUSO_AGENDAMENTO=Etc/UTC

# Atraso tolerado antes de a tela acusar a carga de atrasada. A carga leva
# segundos hoje; a folga cobre fila do cron e variacao do Athena.
ETL_TOLERANCIA_MINUTOS=90

# Idade a partir da qual uma execucao ainda aberta e dada por INTERROMPIDA, e
# nao "em andamento". Precisa ser maior que a duracao normal da carga.
ETL_EXECUCAO_ORFA_MINUTOS=120

# Dias sem dado novo antes de apontar a conta como parada. O CUR da AWS atrasa
# cerca de um dia por natureza, entao 1 geraria alerta falso todo dia.
DIAGNOSTICO_DIAS_SEM_ATUALIZACAO=3

# =============================================================================
# Faturamento
# -----------------------------------------------------------------------------
# Integracao com as APIs de faturamento da AWS. MANTENHA false.
#
# Nao existe integracao implementada, o portal nao tem credencial AWS e -- o
# mais importante -- NENHUMA API da AWS responde de forma confiavel se uma
# fatura FOI PAGA. Elas respondem quanto foi cobrado e quando a fatura foi
# emitida; a quitacao acontece no meio de pagamento, fora da AWS.
#
# Ligar isto sozinho nao ativa nada: a consulta continua respondendo
# indisponivel, e o portal segue sem marcar nada como pago automaticamente. A
# variavel existe para que, no dia em que houver implementacao, ela nasca
# desligada em producao. Investigacao completa em docs/AWS-INVOICING.md.
AWS_INVOICING_ENABLED=false

# =============================================================================
# Execucao LOCAL em Docker (infra/docker-compose.dev.yml)
# -----------------------------------------------------------------------------
# So valem para o compose de desenvolvimento, que roda a imagem de PRODUCAO na
# sua maquina contra um Postgres alcancavel (tipicamente um tunel SSH).
# Mantenha comentadas no `.env` da EC2 -- la valem as APP_PG_* acima.
#
# PG_HOST=host.docker.internal
# PG_PORT=5432
# PG_USER=finops_app
# PG_PASSWORD=a-mesma-senha-do-role-da-aplicacao
# AUTH_COOKIE_SECURE=false
# =============================================================================

# -----------------------------------------------------------------------------
# ADMIN_EMAIL e ADMIN_PASSWORD **nao** entram neste arquivo.
#
# Nao existe cadastro publico: o primeiro administrador e criado por comando
# pontual, com a senha passada apenas no ambiente daquela execucao:
#
#   docker exec -i -e ADMIN_EMAIL -e ADMIN_PASSWORD finops-portal \
#     node scripts/create-admin.mjs
#
# Ver docs/RUNBOOK-app.md, secao de autenticacao.
# -----------------------------------------------------------------------------
