# =============================================================================
# Portal FinOps VERI -- modelo de variaveis de ambiente
# -----------------------------------------------------------------------------
# Copie este arquivo para `.env` NO MESMO DIRETORIO do docker-compose.yml usado
# no deploy (ex.: /opt/finops/.env) e preencha os valores reais.
#
#   cp infra/.env.example /opt/finops/.env && chmod 600 /opt/finops/.env
#
# O `.env` NUNCA deve ser versionado (ja bloqueado no .gitignore).
# =============================================================================

# Caminho ABSOLUTO do diretorio web/ do repositorio clonado na EC2.
# Obrigatorio: e o contexto de build da imagem.
APP_BUILD_CONTEXT=/opt/veri-finops/web

# Banco de dados (o mesmo do ETL/Metabase, apenas leitura + governanca)
PG_DB=finops

# Usuario dedicado da aplicacao. NAO reutilize finops_user (dono do schema):
# o portal deve ter permissao minima. Ver docs/RUNBOOK-app.md.
APP_PG_USER=finops_app
APP_PG_PASSWORD=troque-por-uma-senha-forte-e-unica

# Pool pequeno: o PostgreSQL e compartilhado com o Metabase.
APP_PG_POOL_MAX=5
APP_PG_STATEMENT_TIMEOUT_MS=15000

# Publicacao da porta.
# Padrao seguro: somente loopback da EC2 (acesse por tunel SSH).
# Só troque APP_BIND para 0.0.0.0 depois de colocar Nginx + HTTPS na frente
# e restringir o Security Group.
APP_BIND=127.0.0.1
APP_PORT=8080

# Limite de memoria do container (a EC2 tem ~4 GiB e o Metabase e pesado).
APP_MEM_LIMIT=512m

# Tag da imagem construida.
APP_IMAGE_TAG=local

# Fuso usado para formatar datas na interface.
APP_TZ=America/Sao_Paulo
